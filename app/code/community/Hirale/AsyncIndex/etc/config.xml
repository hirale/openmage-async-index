<?xml version="1.0"?>
<config>
    <modules>
        <Hirale_AsyncIndex>
            <version>1.2.0</version>
        </Hirale_AsyncIndex>
    </modules>
    <global>
        <models>
            <index>
                <rewrite>
                    <indexer>Hirale_AsyncIndex_Model_Indexer</indexer>
                    <process>Hirale_AsyncIndex_Model_Process</process>
                </rewrite>
            </index>
            <hirale_asyncindex>
                <class>Hirale_AsyncIndex_Model</class>
                <resourceModel>hirale_asyncindex_resource</resourceModel>
            </hirale_asyncindex>
            <hirale_asyncindex_resource>
                <class>Hirale_AsyncIndex_Model_Resource</class>
                <entities>
                    <process_state>
                        <table>hirale_asyncindex_process_state</table>
                    </process_state>
                    <full_run>
                        <table>hirale_asyncindex_full_run</table>
                    </full_run>
                </entities>
            </hirale_asyncindex_resource>
        </models>
        <helpers>
            <hirale_asyncindex>
                <class>Hirale_AsyncIndex_Helper</class>
            </hirale_asyncindex>
        </helpers>
        <resources>
            <hirale_asyncindex_setup>
                <setup>
                    <module>Hirale_AsyncIndex</module>
                </setup>
            </hirale_asyncindex_setup>
        </resources>
        <!--
            Maho core queue. Drain and full-reindex batches each get a queue of
            their own so a host can schedule them separately; core's shared
            "default" queue could not be rerouted without moving every core
            message with it. "index_drain" is deliberately left unrouted: it
            falls to the catch-all pool, and a host that wants lower latency
            routes it to a resident pool from its own config.xml or local.xml.
            Ignored by hirale/queue on OpenMage.
        -->
        <queue>
            <routing>
                <full_reindex>slow</full_reindex>
            </routing>
        </queue>
        <hirale_queue>
            <handlers>
                <Hirale_AsyncIndex_Message_DrainEventsMessage>hirale_asyncindex/drainEventsHandler</Hirale_AsyncIndex_Message_DrainEventsMessage>
                <Hirale_AsyncIndex_Message_FullReindexBatchMessage>hirale_asyncindex/fullReindexBatchHandler</Hirale_AsyncIndex_Message_FullReindexBatchMessage>
            </handlers>
        </hirale_queue>
    </global>
    <crontab>
        <jobs>
            <hirale_asyncindex_reconcile>
                <schedule>
                    <cron_expr>* * * * *</cron_expr>
                </schedule>
                <run>
                    <model>hirale_asyncindex/reconciler::execute</model>
                </run>
            </hirale_asyncindex_reconcile>
        </jobs>
    </crontab>
    <default>
        <hirale_asyncindex>
            <settings>
                <enabled>0</enabled>
                <auto_manage_modes>1</auto_manage_modes>
                <restore_modes_on_disable>1</restore_modes_on_disable>
                <auto_reindex_required>1</auto_reindex_required>
                <batch_size>200</batch_size>
                <full_batch_size>500</full_batch_size>
                <max_runtime_seconds>45</max_runtime_seconds>
                <clean_cache_after_reindex>0</clean_cache_after_reindex>
                <invalidate_entity_limit>500</invalidate_entity_limit>
                <full_reindex_queue></full_reindex_queue>
            </settings>
        </hirale_asyncindex>
    </default>
</config>
