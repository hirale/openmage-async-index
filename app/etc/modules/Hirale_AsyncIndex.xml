<?xml version="1.0"?>
<config>
    <modules>
        <Hirale_AsyncIndex>
            <active>true</active>
            <codePool>community</codePool>
            <!--
                Hirale_Queue is deliberately not a hard dependency: on Maho the module
                dispatches through core Maho_Queue and hirale/queue is not installed,
                and an unmet <depends> aborts config loading for the whole store.
            -->
            <depends>
                <Mage_Index/>
            </depends>
        </Hirale_AsyncIndex>
    </modules>
</config>
